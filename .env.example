# Plantilla de variables de entorno.
# Copiar a un archivo .env y completar los valores. El .env NO se versiona
# (está en .gitignore). Las credenciales reales se solicitan al equipo.

# --- Base de datos (PostgreSQL gestionado en Supabase, acceso privado) ---
# Usar la cadena del "Session pooler" (IPv4). Con el pooler, DB_USER incluye
# el project ref (p. ej. postgres.<project_ref>), no solo "postgres".
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# --- Modelo de lenguaje (Google Gemini, SDK google-genai) ---
# Se usa solo en la fase de aprendizaje para inferir el mapeo entre portales.
GEMINI_API_KEY=

# --- Notificaciones por WhatsApp (Twilio) — opcional ---
# Requeridas únicamente si se habilitan las alertas de negocio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
